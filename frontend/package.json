{
  "name": "coolssh",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#bindings/*": "./bindings/github.com/dortanes/coolssh/internal/*"
  },
  "scripts": {
    "dev": "pnpm messages && rsbuild dev",
    "build": "pnpm messages && rsbuild build",
    "build:dev": "pnpm messages && rsbuild build --mode development",
    "messages": "paraglide-js compile --silent --project ./project.inlang --outdir ./src/paraglide --strategy globalVariable baseLocale --no-emit-git-ignore --no-emit-prettier-ignore --no-emit-readme",
    "lint": "biome check",
    "check": "biome check --write",
    "typecheck": "pnpm messages && tsc",
    "test": "pnpm messages && node --experimental-transform-types --no-warnings=ExperimentalWarning --test --test-reporter=dot 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@headless-tree/core": "1.8.0",
    "@headless-tree/react": "1.8.0",
    "@wailsio/runtime": "3.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.0",
    "tinykeys": "4.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@inlang/paraglide-js": "^3.2.2",
    "@inlang/plugin-message-format": "^4.6.0",
    "@rsbuild/core": "^2.3.2",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jscpd": "^5.4.3",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
